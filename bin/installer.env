# Release-owned settings shared by the Windows, macOS, and Linux installers.
INSTALLER_API=2
APP_REPO=https://github.com/kholbrook1303/WaveCymatix.git
APP_DEFAULT_REF=latest
ASSETS_REPO=https://github.com/kholbrook1303/WaveCymatix-Visuals.git
ASSETS_DEFAULT_REF=main
PROJECTM_REPO=https://github.com/projectM-visualizer/projectm.git
PROJECTM_VERSION=4.1.8
PROJECTM_DEFAULT_REF=
PROJECTM_RENDERER=core
PROJECTM_CMAKE_FLAGS_WINDOWS=-DENABLE_GLES=OFF -DENABLE_PLAYLIST=ON
PROJECTM_CMAKE_FLAGS_MACOS=-DENABLE_GLES=OFF
PROJECTM_CMAKE_FLAGS_LINUX=-DENABLE_GLES=OFF
PYTHON_VERSION=3.12
MIN_CMAKE_VERSION=3.21.0
NODE_VERSION=20.20.2
PLEXAMP_VERSION=4.12.4
DEJAVU_FONT_VERSION=2.37
DEJAVU_FONT_URL=https://github.com/dejavu-fonts/dejavu-fonts/releases/download/version_2_37/dejavu-fonts-ttf-2.37.zip
DEJAVU_FONT_SHA256=7576310B219E04159D35FF61DD4A4EC4CDBA4F35C00E002A136F00E96A908B0A
LIBERATION_FONT_VERSION=2.1.5
LIBERATION_FONT_URL=https://github.com/liberationfonts/liberation-fonts/files/7261482/liberation-fonts-ttf-2.1.5.tar.gz
VCPKG_REPO=https://github.com/microsoft/vcpkg.git
VCPKG_REF=master
WIN_VS_GENERATOR=Visual Studio 17 2022
WIN_CMAKE_ARCH=x64
WIN_GIT_PACKAGE_ID=Git.Git
WIN_CMAKE_PACKAGE_ID=Kitware.CMake
WIN_PYTHON_PACKAGE_PREFIX=Python.Python.
WIN_FFMPEG_PACKAGE_ID=Gyan.FFmpeg
WIN_VLC_PACKAGE_ID=VideoLAN.VLC
CMAKE_VERSION=3.31.8
BLUEZ_VERSION=5.87
SHAIRPORT_SYNC_VERSION=5.5.2
NQPTP_VERSION=1.2.8
SPOTIFYD_VERSION=0.4.2
